# Leads are WRITTEN here — the same Postgres as the main app.
# Copy from backend/.env.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Societies are READ from here (master_societies) — the acquisition
# Properties DB, a different database. Read-only; never written to.
# Copy from backend/.env.
PROPERTIES_DB_URL="postgresql://user:password@host/dbname?sslmode=require"

# Kaleyra SMS (OTP). India region.
KALEYRA_API_KEY=""
KALEYRA_ACCOUNT_ID=""            # the SID in the API path, e.g. HXIN...IN
KALEYRA_SMS_SENDER=""            # 6-char DLT-approved sender ID
KALEYRA_OTP_TEMPLATE_ID=""       # DLT template id
# Must match the DLT-registered SMS template. {otp} is replaced with the code.
KALEYRA_OTP_BODY="Your OTP for login is {otp}. Avano Technologies Pvt Ltd."
